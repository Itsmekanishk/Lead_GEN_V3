# ---------------------------------------------------------------------------
# LocalLead Intelligence — frontend environment template
#
#   cp frontend/.env.example frontend/.env.local
#
# Next.js only reads files inside this directory: a root-level .env is NOT
# visible to the browser bundle. NEXT_PUBLIC_* values are inlined at build
# time, so restart `npm run dev` (or redeploy on Vercel) after changing them.
# ---------------------------------------------------------------------------

# Supabase project URL and anon/publishable key.
# Dashboard → Project Settings → API. The anon key is public by design; the
# service_role / secret key must NEVER be used here.

# Public origin of the FastAPI service (no /api suffix).
#   * Local dev / docker-compose: leave EMPTY — requests go to /backend/*,
#     which Next.js proxies to http://localhost:8000 (dev) or the api
#     container (production compose).
#   * Vercel: REQUIRED. Vercel is not part of the compose network, so the proxy
#     does not exist there. Use the public HTTPS backend origin, e.g.
#     https://locallead-api.onrender.com — and add the same origin to the
#     backend's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=

# Display name shown in the UI.
NEXT_PUBLIC_APP_NAME=LocalLead Intelligence
