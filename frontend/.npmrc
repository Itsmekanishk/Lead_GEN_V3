# @cloudflare/next-on-pages@1.13.x declares `peer next ">=14.3.0 && <=15.5.2"`,
# while this app is pinned to Next 14.2.35 (the 14.3 line never shipped). The
# adapter works on 14.2 — verified locally with `wrangler pages dev`: /,
# /dashboard, /history and /results/<id> all return 200 — but npm refuses to
# install it without this flag. Kept in the repo so Cloudflare Pages resolves
# the same tree we build locally; remove it after the Next 15 migration.
legacy-peer-deps=true
