# Names only — never commit real values.
# Set each one with: npx wrangler secret put <NAME>
# (run inside cloudflare/, after `npx wrangler login`)

# --- required -------------------------------------------------------------
SECRET_KEY=            # openssl rand -hex 32
DATABASE_URL=          # postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require
REDIS_URL=             # rediss://default:PASSWORD@HOST:6379
CORS_ORIGINS=          # https://yourdomain.com
FRONTEND_ORIGIN=       # https://yourdomain.com

# --- optional -------------------------------------------------------------
ENCRYPTION_KEY=        # Fernet key for admin-managed provider keys at rest
BUSINESS_PROVIDER=     # nominatim (default, keyless) | google | serper | geoapify
GOOGLE_MAPS_API_KEY=
SERPER_API_KEY=
GEOAPIFY_API_KEY=
APILAYER_API_KEY=
NUMVERIFY_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
